# Jarvis PyQt — Environment Variables Template
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will NOT be committed.
# NEVER put real secrets in THIS file — it is version-controlled.

# ─── Database (MariaDB) ─────────────────────────────────────────────
JARVIS_DB_HOST=127.0.0.1
JARVIS_DB_PORT=3306
JARVIS_DB_USER=jarvis
JARVIS_DB_PASSWORD=CHANGE_ME
JARVIS_DB_NAME=jarvis

# ─── LLM Endpoint (OpenAI-compatible) ───────────────────────────────
JARVIS_LLM_URL=http://CHANGE_ME:8642/v1
JARVIS_LLM_API_KEY=CHANGE_ME
JARVIS_LLM_MODEL=auto

# ─── STT (Wyoming protocol — faster-whisper) ────────────────────────
JARVIS_STT_HOST=127.0.0.1
JARVIS_STT_PORT=10300

# ─── TTS (Wyoming protocol — Piper) ────────────────────────────────
JARVIS_TTS_HOST=127.0.0.1
JARVIS_TTS_PORT=10200
JARVIS_TTS_VOICE=en_US-lessac-medium

# ─── STT Sensitivity ──────────────────────────────────────────────────
# RMS amplitude threshold for silence detection (lower = more sensitive)
JARVIS_STT_SENSITIVITY=100

# ─── Silence Timeout ──────────────────────────────────────────────────
JARVIS_SILENCE_TIMEOUT=2.0

# ─── Logging ─────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
JARVIS_LOG_LEVEL=INFO
